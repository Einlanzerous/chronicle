    "views": [
      {
        "id": "capture-path",
        "label": "A memo, end to end",
        "focus": [
          "phone",
          "api",
          "audio",
          "asr",
          "gemma",
          "postgres"
        ],
        "note": "Phone uploads audio; the API stores it, has the shared ASR transcribe it, then asks a local model where it belongs."
      },
      {
        "id": "sign-in",
        "label": "Who is let in",
        "focus": [
          "web",
          "agents",
          "cfaccess",
          "api"
        ],
        "note": "Access decides whether a request is served; Chronicle verifies the assertion itself and decides who it is served as."
      },
      {
        "id": "linked-not-copied",
        "label": "Linked, never copied",
        "focus": [
          "api",
          "switchyard",
          "amber"
        ],
        "note": "Tickets and archive items resolve at render time and are never written into Chronicle's tables."
      }
    ]
