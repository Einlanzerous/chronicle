<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Talking to Chronicle. Every request this app makes goes to the one base
         URL the invite QR supplied; there is no discovery and no second host. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Scanning the sign-in code CHRN-106 renders (Account -> Add device).
         mobile_scanner asks for the runtime permission when the scanner opens,
         so nothing prompts on first launch. -->
    <uses-permission android:name="android.permission.CAMERA"/>

    <!-- CHRN-60. Recording, and keeping it running when the screen locks or the
         app backgrounds. Without FOREGROUND_SERVICE_MICROPHONE and a service
         declaring that type, Android mutes the microphone the moment the app
         leaves the foreground, and the ticket's "survives screen-off and
         backgrounding" is not achievable at all. Asked for at the first tap,
         never at launch. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>

    <!-- The recording notification. A foreground service runs whether or not
         this is granted — only the visible indicator is lost — so a refusal
         must never stop a recording. Gating capture on a notification
         permission would reintroduce, in a different costume, the dependency
         this epic exists to remove. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- A foreground service is not a CPU guarantee. The capture service holds a
         partial wake lock for the life of a recording, which is what Argosy
         declares this for too. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <application
        android:label="Chronicle"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false">
        <!-- allowBackup is OFF, and the default is the wrong one here (CHRN-60).
             Android's auto-backup includes an app's internal files, so leaving it
             alone would replicate the memo corpus to the holder's cloud backup —
             the opposite of what this system is for. The app holds nothing worth
             restoring anyway: the server address is a preference and the session
             token is in keystore-backed storage, neither of which survives a
             restore usefully. The consequence, taken deliberately: a
             device-to-device transfer drops captures the server has not yet
             acknowledged, which is the same exposure as uninstalling with a
             queue still draining. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- CHRN-60's recorder. It owns MediaRecorder and the file descriptor,
             and its lifetime IS the recording's: the notification is the
             affordance for stopping, so swiping the app out of Recents leaves it
             running rather than ending a thought mid-sentence.

             No android:process, and that is load-bearing rather than incidental.
             Running in the app's own process is what lets recovery read the
             service's registry of held captures directly — no IPC, no deadline,
             and a force-stopped process comes back with an empty registry, which
             is exactly the classification recovery needs. -->
        <service
            android:name=".capture.CaptureService"
            android:foregroundServiceType="microphone"
            android:exported="false"/>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
